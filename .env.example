# 2. Kết nối Supabase (Database Postgres + Storage lưu file tài liệu)
# Khi cài Supabase qua Vercel Marketplace, các biến này sẽ được tự động bơm vào Project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL=

# 3. Đăng nhập bằng Google (OAuth 2.0) — Tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs cần thêm:
#   - http://localhost:3005/api/auth/google/callback
#   - https://<ten-mien-cua-anh>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. Cấu hình tài khoản nhận thanh toán VietQR (Mặc định gắn Techcombank Công Ty TNHH Astronixa)
